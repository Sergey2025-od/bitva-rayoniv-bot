generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vote {
  id          Int      @id @default(autoincrement())
  userId      String
  username    String?
  district    String
  amount      Int
  screenshot  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model Poll {
  id          Int      @id @default(autoincrement())
  title       String
  messageId   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}